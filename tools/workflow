#!/bin/bash
#
# Wrapper script for workflow.py - easier to type!
#
# Usage:
#   workflow status problem-001
#   workflow validate problem-001
#   workflow run-all problem-001
#   workflow run-all problem-001 -j 8   # 8 concurrent jobs
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python3 "$SCRIPT_DIR/workflow.py" "$@"
