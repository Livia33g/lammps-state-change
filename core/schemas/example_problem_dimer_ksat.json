{
  "problem_id": "problem-001-dimer-ksat",
  "title": "A→C Catalytic Conversion via B Species",
  "description": "Convert A-labeled monomers to C-labeled monomers using B as a catalyst. Minimize fuel consumption (flip count) while maximizing C yield. This is a simplified k-SAT encoding where A represents unsatisfied clauses and C represents satisfied clauses, with B acting as variable flips.",

  "category": "species_conversion",

  "encoding": {
    "geometry": "1core_3patch",
    "species": [
      {
        "label": "core",
        "lammps_type": 1,
        "role": "core",
        "description": "Rigid body core (unchanging)"
      },
      {
        "label": "A",
        "lammps_type": 2,
        "role": "patch",
        "description": "A-labeled patch (initial state, can flip to C)"
      },
      {
        "label": "B",
        "lammps_type": 3,
        "role": "patch",
        "description": "B-labeled patch (catalyst, unchanging)"
      },
      {
        "label": "C",
        "lammps_type": 4,
        "role": "patch",
        "description": "C-labeled patch (target state)"
      }
    ],
    "initial_composition": {
      "A": 20,
      "B": 10
    },
    "system_parameters": {
      "particle_count": 30,
      "density": 0.001,
      "temperature": 0.5,
      "box_size": 50.0
    }
  },

  "decoding": {
    "yield_mode": "species_fraction",
    "target": {
      "species_label": "C"
    },
    "threshold": 0.6,
    "measurement_interval": 1000,
    "analysis_script": "analyze_trajectory_target_yield_and_work.py",
    "analysis_args": {
      "site_types": [2, 3, 4],
      "bond_cutoff": 0.7
    }
  },

  "scoring": {
    "primary_metric": "work_per_yield",
    "description": "Minimize fuel consumed per unit of C-yield. Work = ΔPE between thermo outputs.",
    "secondary_metrics": [
      "final_yield",
      "flip_count",
      "time_to_threshold"
    ],
    "normalization": "raw",
    "penalties": [
      {
        "type": "timeout",
        "threshold": 1000000,
        "penalty_factor": 0.0
      },
      {
        "type": "low_yield",
        "threshold": 0.1,
        "penalty_factor": 10.0
      }
    ]
  },

  "constraints": {
    "max_timesteps": 1000000,
    "allowed_transitions": [
      "A-C",
      "C-A"
    ],
    "fixed_parameters": [
      "geometry",
      "particle_count",
      "temperature",
      "density"
    ],
    "tunable_parameters": [
      {
        "name": "morse_depth_AB",
        "min": 0.1,
        "max": 5.0,
        "default": 1.0,
        "description": "Morse potential depth for A-B interaction"
      },
      {
        "name": "morse_depth_BC",
        "min": 0.1,
        "max": 5.0,
        "default": 1.0,
        "description": "Morse potential depth for B-C interaction"
      },
      {
        "name": "morse_alpha",
        "min": 1.0,
        "max": 10.0,
        "default": 5.0,
        "description": "Morse potential width parameter"
      }
    ]
  },

  "validation": {
    "min_replicas": 1,
    "equilibration_time": 10000,
    "correctness_checks": [
      "molecule_count",
      "topology_valid"
    ]
  },

  "references": {
    "proposal_section": "3-SAT and Species Conversion",
    "related_work": [
      "Simplified version of k-SAT clause satisfaction",
      "Tests basic non-equilibrium fuel-driven computation"
    ]
  }
}
