# ===================== 1) Simulation setup =====================
units lj
dimension 3
atom_style molecular              # we'll integrate each 7-atom particle as a rigid body
boundary p p p

# --------------------- Box & molecule template -----------------
region simulation_box block -10 10 -10 10 -10 10
create_box 7 simulation_box       # 7 atom types total in the system
molecule part1 part1tripatch_mid.mol   # your 7-atom template (types 1..3 in the file)

# --------------------- Create 600 molecules ---------------------
create_atoms 0 random 600 1234 simulation_box mol part1 1234

# --------------------- Tag A / B / C by molecule index --------
group molA molecule 1:200
group molB molecule 201:400
group molC molecule 401:600

# --------------------- Retype patches to make A,B,C -----------
# Template uses: core=1, patches types=2 (one side) and 3 (other side)
group type2 type 2
group type3 type 3

# B: turn type-2 -> 4 and type-3 -> 5
group molB_type2 intersect molB type2
group molB_type3 intersect molB type3
set group molB_type2 type 4
set group molB_type3 type 5

# C: turn type-2 -> 6 and type-3 -> 7
group molC_type2 intersect molC type2
group molC_type3 intersect molC type3
set group molC_type2 type 6
set group molC_type3 type 7

# --------------------- Masses ---------------------------------
variable size1 equal 1.0
variable size2 equal 0.1
variable mass1 equal ${size1}^3
variable mass2 equal ${size2}^3
mass 1 ${mass1}                     # cores
mass 2*7 ${mass2}                   # all patch beads

# Group containing everything (used by fixes)
group particle1 type 1 2 3 4 5 6 7

# ===================== 2) Gentle "soft" relax WITH RIGID ======
# Purpose: remove overlaps safely *while keeping molecules intact*.
# Key idea: DO NOT minimize or run MD with free atoms; keep rigid ON here.

pair_style soft 2.0
pair_coeff * * 300.0                # soft repulsion strength for brief relax

timestep 0.0001
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes
comm_modify cutoff 4.5              # generous ghost cutoff so rigid always fits

# Rigid bodies + gentle Langevin at a moderate T
fix R particle1 rigid/nve/small molecule langevin 0.5 0.5 0.1 98765
run 4000                             # short relax (a few thousand steps)
unfix R


# ===================== PLOT TABLES: safe single-style snapshots =====================

# # --- 1) WCA (LJ/cut + shift) core-core (1-1) ---
# pair_style lj/cut 2.5
# pair_modify shift yes
# pair_coeff * * 0.0 1.0 1.0
# pair_coeff 1 1 1.0 1.0 1.1224620483
# pair_write 1 1 1000 r 0.80 2.00 tables/lj_11.table WCA_11

# # --- 2) WCA core–patch (1–2) ---
# pair_style lj/cut 2.5
# pair_modify shift yes
# pair_coeff * * 0.0 1.0 1.0
# pair_coeff 1 2 1.0 0.6 0.67347722899
# pair_write 1 2 1000 r 0.40 1.20 tables/lj_12.table WCA_12

# # --- 3) WCA patch–patch (2–2) ---
# pair_style lj/cut 2.5
# pair_modify shift yes
# pair_coeff * * 0.0 1.0 1.0
# variable rcPP equal 0.22449240966
# pair_coeff 2 2 1.0 0.20 ${rcPP}
# pair_write 2 2 1000 r 0.15 0.60 tables/lj_22.table WCA_22

# # --- 4) Morse (3–4) ---
# pair_style morse 1.2
# pair_modify shift yes
# pair_coeff * * 0.0 1.0 1.0
# pair_coeff 3 4 8.0 20.0 0.225
# pair_write 3 4 2000 r 0.15 0.60 tables/morse_34.table MORSE_34

# # --- 5) Morse (5–6) ---
# pair_style morse 1.2
# pair_modify shift yes
# pair_coeff * * 0.0 1.0 1.0
# pair_coeff 5 6 8.0 20.0 0.225
# pair_write 5 6 2000 r 0.15 0.60 tables/morse_56.table MORSE_56

# --- 6) RESTORE your original physical model (exactly your Section 3) ---
# ===================== 3) Physical interactions: WCA + Morse ===
# WCA = shifted LJ truncated at 2^(1/6)*sigma (purely repulsive)
# Morse well OVERLAYED ONLY on the intended sticky pairs (3-4 and 5-6)
pair_style hybrid/overlay lj/cut 2.5 morse 1.2
pair_modify shift yes

# ---- WCA for cores and core–patch (purely repulsive) ----------
# core-core: sigma=1.0 -> rcut = 1.1224620483
pair_coeff 1 1 lj/cut 1.0 1.0 1.1224620483
# core–patch: sigma=0.6 -> rcut = 0.67347722899
pair_coeff 1 2 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 3 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 4 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 5 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 6 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 7 lj/cut 1.0 0.6 0.67347722899


# ---- WCA for ALL patch–patch pairs (including sticky ones) ----
variable rcPP equal 0.22449240966   # = 2^(1/6)*sigma_pp with sigma_pp=0.20
pair_coeff 2 2 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 3 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 4 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 5 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 6 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 7 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 3 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 4 lj/cut 1.0 0.20 ${rcPP}   # sticky pair still has WCA
pair_coeff 3 5 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 6 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 7 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 4 4 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 4 5 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 4 6 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 4 7 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 5 5 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 5 6 lj/cut 1.0 0.20 ${rcPP}   # sticky pair still has WCA
pair_coeff 5 7 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 6 6 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 6 7 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 7 7 lj/cut 1.0 0.20 ${rcPP}

# ---- Morse wells ONLY for (3,4) and (5,6): capture at contact -
pair_coeff 3 4 morse 8.0 20.0 0.225
pair_coeff 5 6 morse 8.0 20.0 0.225



# ===================== 4) Rigid-body MD (assembly) =============
# Now run with physical interactions. Keep comm cutoff generous first,
# then you can lower it once you confirm the printed "rigid extent".
timestep 0.0002
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes

# (Optional) after bodies are intact, you may exclude intra-body pairs
# to save compute; safe to enable now (AFTER soft stage was done rigidly).
neigh_modify exclude molecule/intra particle1

# Diagnostics & output
thermo 20000
thermo_style custom step temp press pe ke
thermo_modify lost warn
dump mydmp all custom 10000 dump/dump_tripatch_3distinct_morsechanges_new_large_longtime.lammpstrj id mol type x y z

# Initialize velocities (also sets angular DOFs for rigid)
velocity particle1 create 1.0 987654 dist gaussian rot yes

# Explore at T=1.0 then anneal to 0.4
fix R particle1 rigid/nve/small molecule langevin 1.0 1.0 0.1 1234
run 900000

unfix R
fix R particle1 rigid/nve/small molecule langevin 1.0 0.4 0.1 4321
run 1800000

# ===================== 5) (Optional) live binding counters =====
# group ApatchR type 3
# group BpatchL type 4
# group BpatchR type 5
# group CpatchL type 6
# compute cab all coord/atom cutoff 0.28 type 4
# compute cbc all coord/atom cutoff 0.28 type 6
# compute sumAB ApatchR reduce sum c_cab
# compute sumBC BpatchR reduce sum c_cbc
# variable nAB equal c_sumAB
# variable nBC equal c_sumBC
# thermo_style custom step temp press pe v_nAB v_nBC
