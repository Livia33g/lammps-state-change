# LAMMPS input script for ksat patchy particles with state change
# Generated: 2025-12-12 14:47:28.431414
# Monomers: 200 type A + 400 type B = 600 total
# State change: Type 3 → 4 when attached to type 2

units lj
dimension 3
atom_style molecular
boundary p p p

# Read data file
read_data data.ksat_monomers

# Define groups
group body type 1
group patches type 2 3 4
group type2 type 2
group all type 1 2 3 4

# ===================== Soft relaxation =====================
pair_style soft 2.0
pair_coeff * * 300.0

timestep 0.0001
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes
comm_modify cutoff 4.5

fix R all rigid/nve/small molecule langevin 0.5 0.5 0.1 98765
run 4000
unfix R

# ===================== Physical interactions: WCA + Morse =====================
pair_style hybrid/overlay lj/cut 2.5 morse 0.6
pair_modify shift yes

# WCA core-core (sigma=1.0, rcut=1.1224620483)
pair_coeff 1 1 lj/cut 1.0 1.0 1.1224620483

# WCA core-patch (sigma=0.6, rcut=0.67347722899)
pair_coeff 1 2 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 3 lj/cut 1.0 0.6 0.67347722899
pair_coeff 1 4 lj/cut 1.0 0.6 0.67347722899

# WCA patch-patch (sigma=0.20, rcut=0.22449240966)
variable rcPP equal 0.22449240966
pair_coeff 2 2 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 3 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 2 4 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 3 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 3 4 lj/cut 1.0 0.20 ${rcPP}
pair_coeff 4 4 lj/cut 1.0 0.20 ${rcPP}

# Stronger steric clash for same-type patches
variable fac equal 1.122462048309373
variable sig33 equal 0.30
variable rc33 equal ${fac}*${sig33}
pair_coeff 3 3 lj/cut 1.0 ${sig33} ${rc33}
pair_coeff 4 4 lj/cut 1.0 ${sig33} ${rc33}

# Morse attractions: 2-3 and 2-4 only
pair_coeff 2 3 morse 8.0 20.0 0.225
pair_coeff 2 4 morse 8.0 20.0 0.225

# ===================== State change setup =====================
fix STATE all state/change/ksat 100 1000 0.7 0.28 patches

# ===================== Rigid-body MD =====================
timestep 0.0002
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes
neigh_modify exclude molecule/intra all

thermo 20000
thermo_style custom step temp press pe ke f_STATE
thermo_modify lost warn
dump mydmp all custom 10000 dump.ksat_monomers.lammpstrj id mol type x y z

velocity all create 1.0 987654 dist gaussian rot yes

# Run at T=1.0
fix R all rigid/nve/small molecule langevin 1.0 1.0 0.1 1234
run 900000
unfix R

# Run at T=0.4
fix R all rigid/nve/small molecule langevin 1.0 0.4 0.1 4321
run 1800000
unfix R

print 'Simulation completed successfully'
