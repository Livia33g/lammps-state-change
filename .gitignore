# LAMMPS output files
*.lammpstrj
*.log
*.out
*.err

# SLURM output files
slurm-*.out
slurm-*.err
slurm_cpp_fix-*.out
slurm_cpp_fix-*.err

# Generated simulation directories
rigid_patchy_simulation/
rigid_patchy_monomer_simulation/
rigid_patchy_simulation_cpp/
rigid_patchy_simulation_cpp_test/
rigid_patchy_simulation_continuous/
test_potentials/

# Per-variant generated outputs (new convention)
**/simulation_cpp/

# State-change generated outputs (do not commit)
dimer_simulation_cpp/
debugging/
octahedron/octahedron_simulation_cpp/
octahedron/octahedron_simulation_test/
octahedron/octahedron_shape/

# LAMMPS runtime logs that don't match *.log
log.lammps

# Analysis outputs (ignore artifacts; keep templates)
**/analysis/*.csv
**/analysis/*.png
**/analysis/*.leaderboard.csv
**/analysis/leaderboard.csv
!**/analysis/README.md
!**/analysis/submit_analysis.slurm
!**/analysis/tasks/
!**/analysis/tasks/*.json

# Local archive + legacy folders (do not commit)
back/
back/**
legacy/
legacy/**

# User submissions (local development only - do not push to remote)
# First, allow documentation files (must come before ignore patterns)
!submissions/.gitkeep
!submissions/README.md
!submissions/**/EXAMPLE_STRUCTURE.md
# Now ignore all competitor submission directories and files
submissions/
# Explicitly ignore all actual submission files (policy.json, params.json, etc.)
submissions/**/policy.json
submissions/**/params.json
submissions/**/submission.json
# Ignore all generated files within submissions
submissions/**/generated/
submissions/**/simulation/
submissions/**/results/

# Test outputs (local development only - do not push to remote)
tests/
!tests/.gitkeep
!tests/**/README.md
# Ignore all generated files within tests
tests/**/generated/
tests/**/simulation/
tests/**/temp_params.json

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

